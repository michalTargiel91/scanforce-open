<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <actionCalls>
        <name>Process_Salesforce_File</name>
        <label>Process Salesforce File</label>
        <locationX>264</locationX>
        <locationY>647</locationY>
        <actionName>SfdcDcx_Submit</actionName>
        <actionType>apex</actionType>
        <connector>
            <targetReference>For_Each_Link</targetReference>
        </connector>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>contentVersionId</name>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>sourceRecordId</name>
            <value>
                <elementReference>For_Each_Link.LinkedEntityId</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>documentType</name>
            <value>
                <stringValue>invoice</stringValue>
            </value>
        </inputParameters>
        <nameSegment>SfdcDcx_Submit</nameSegment>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </actionCalls>
    <apiVersion>67.0</apiVersion>
    <decisions>
        <name>Is_Opportunity</name>
        <label>Linked to an Opportunity?</label>
        <locationX>396</locationX>
        <locationY>539</locationY>
        <defaultConnector>
            <targetReference>For_Each_Link</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Opportunity_Link</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>LinkIsOpportunity</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Process_Salesforce_File</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <description>Example (ScanForce Open): when a user with the Use ScanForce Open permission uploads a file to an Opportunity, process it as an invoice with the Opportunity as source record. Processing runs in the background; the upload never waits for the provider. Files other than PDF, PNG or JPEG are rejected by the action without creating a job.</description>
    <environments>Default</environments>
    <formulas>
        <name>LinkIsOpportunity</name>
        <dataType>Boolean</dataType>
        <expression>BEGINS({!For_Each_Link.LinkedEntityId}, &quot;006&quot;)</expression>
    </formulas>
    <interviewLabel>ScanForce Open Example: Opportunity Invoice Intake {!$Flow.CurrentDateTime}</interviewLabel>
    <label>ScanForce Open Example: Opportunity Invoice Intake</label>
    <loops>
        <name>For_Each_Link</name>
        <label>For each record the file is shared with</label>
        <locationX>176</locationX>
        <locationY>431</locationY>
        <collectionReference>Get_File_Links</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Is_Opportunity</targetReference>
        </nextValueConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_File_Links</name>
        <label>Get the file's record links</label>
        <locationX>176</locationX>
        <locationY>323</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>For_Each_Link</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>ContentDocumentId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.ContentDocumentId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>ContentDocumentLink</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>LinkedEntityId</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_File_Links</targetReference>
        </connector>
        <filterFormula>{!$Permission.SfdcDcx_Use}</filterFormula>
        <object>ContentVersion</object>
        <recordTriggerType>Create</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Draft</status>
</Flow>
